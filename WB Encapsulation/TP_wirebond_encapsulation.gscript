# Routine for encapsulating a single throughput mockup
# Intended for Encapsulation R&D

CLEARLOG
LOADCONFIG

# Load throughput config for geometry definitions and part default locations
LOADCONFIG "" Scripts\ETLModules\ThroughPut\TP_Config.txt
LOADCONFIG "" Config\ETL\TP_Site_Config.txt

LOADCONFIG "" "Scripts\ETLModules\WB Encapsulation\WBE_config.txt"

HOME if-needed
DIALOG "Scripts\ETLModules\WB Encapsulation\Encapsulation_Setup_Dialog.ini"

SETVAC etl_chuck_{$pcb_chuck_num} 1  # vacuum for assembly plate
MOVENAME etl_chuck_{$pcb_chuck_num}

COPY $mod_idx 0
@PCB_SURVEY_LOOP_START
    INC $mod_idx
    GOTOIF @PCB_SURVEY_LOOP_END `$mod_idx>4`
    GOTOIFN @PCB_SURVEY_LOOP_START &enabled_{$mod_idx}
    PRINT "Begin Survey of Module PCB %d, ID=%d" $mod_idx &id_{$mod_idx}

    CALL @SURVEY_PART_FROM_CONFIG $pcb_chuck_num $mod_idx 1 -> $pos $rot
    COPY &pcb_init_pos_{$mod_idx} $pos
    COPY &pcb_init_rot_{$mod_idx} $rot

    GOTO @PCB_SURVEY_LOOP_START
@PCB_SURVEY_LOOP_END

PRINT "Loading Needle"
MOVENAME needle_load
ALERT "Load the syringe into the holder and install a needle"
LOADTOOL syringe_tool
ALERT "Enter the time the encapsulant was mixed"
GETTIME $mix_time

CHOICEPOPUP $choice "Recalibrate needle?"
GOTOIFN @SKIP_CAL $choice
CALL @NEEDLE_CAL -> $needle_offset
PRINT "Found needle calibration offset: %.3v" $needle_offset
GOTO @AFTER_CAL
@SKIP_CAL
# COPY $needle_offset &potting.needle_cal_default
@AFTER_CAL
PRINT "Using needle tip offset: %.3v" $needle_offset

CALL @NEEDLE_PURGE

MOVENAME etl_chuck_{$pcb_chuck_num}

COPY $mod_idx 0
@ENCAP_LOOP_START
    INC $mod_idx
    GOTOIF @ENCAP_LOOP_END `$mod_idx>4`
    GOTOIFN @ENCAP_LOOP_START &enabled_{$mod_idx}
    
    TRANSFORML2G $start &line1_start &pcb_init_pos_{$mod_idx} &pcb_init_rot_{$mod_idx}
    TRANSFORML2G $end &line1_end &pcb_init_pos_{$mod_idx} &pcb_init_rot_{$mod_idx}
    PRINT "Potting line 1 for Module %d from %.3v to %.3v" $mod_idx $start $end
    POTLINE $start $end $needle_offset $mix_time
    
    TRANSFORML2G $start &line2_start &pcb_init_pos_{$mod_idx} &pcb_init_rot_{$mod_idx} 3
    TRANSFORML2G $end &line2_end &pcb_init_pos_{$mod_idx} &pcb_init_rot_{$mod_idx}
    PRINT "Potting line 2 for Module %d from %.3v to %.3v" $mod_idx $start $end
    POTLINE $start $end $needle_offset  $mix_time

    GOTO @ENCAP_LOOP_START
@ENCAP_LOOP_END

MOVENAME etl_chuck_{$pcb_chuck_num}
SETVAC etl_chuck_{$pcb_chuck_num} 0
PRINT "Encapsulation Complete"

MOVENAME needle_load
ALERT "Unload syringe if finished"
MOVENAME home


END

@NEEDLE_CAL()
    MOVENAME needle_calibration
    MOVETO &potting.needle_cal_pos 50
    # Acquire position 1 with gantryhead cam looking at inverted needle tip
    SETLIGHT 40
    VIDEO "" needle_cal1
    GETPOS $cal_pos_1

    # Safely move to the pre-calibrated position with the loaded needle 2mm above the inverted needle tip
    MOVETO {$cal_pos_1.x,$cal_pos_1.y,0} 50
    SUB $cal_pos_2 $cal_pos_1 &potting.needle_cal_default
    MOVETO {$cal_pos_2.x,$cal_pos_2.y,0} 50
    SUB $cal_pos_2 $cal_pos_2 {0,0,2}
    MOVETO $cal_pos_2 50
    
    # Now go between the two webcams to line up the two needle tips
    @NEEDLE_CAL_P2_START
    VIDEO needlecam1
    VIDEO needlecam2
    CHOICEPOPUP $choice "Do you want to continue adjusting the position?" "yes" "no"
    GOTOIF @NEEDLE_CAL_P2_START $choice
    GETPOS $cal_pos_2
    MOVETO {$cal_pos_2.x,$cal_pos_2.y,0} 50
    MOVENAME needle_calibration

    SUB $needle_offset $cal_pos_1 $cal_pos_2
    RETURN $needle_offset

@NEEDLE_PURGE()
    MOVENAME needle_load
    @NEEDLE_PURGE_START
    CHOICEPOPUP $choice "Purge needle for 1 second" "continue" "no, it's done"
    GOTOIFN @NEEDLE_PURGE_END $choice
    SETDISPENSE 1
    WAIT 1000 # ms
    SETDISPENSE 0
    GOTO @NEEDLE_PURGE_START
    @NEEDLE_PURGE_END
    RETURN

@SURVEY_PART_FROM_CONFIG(chuck_num,pos_num,part_id)
    # Arguments:
    #  $chuck_num - 
    #  $pos_num - 
    #   part_id=1 => Module PCB
    #   part_id=2 => ETROC
    # Returns
    #  $pos - center of part
    #  $phi - rotation of part in x-y plane

    GOTOIF @SPC_MODULE_PCB `$part_id==1`
    GOTOIF @SPC_ETROC `$part_id==2`
    
    @SPC_MODULE_PCB
      COPY $pos_default &default.Module_PCB.{$chuck_num}.{$pos_num}.pos
      COPY $rot_default &default.Module_PCB.{$chuck_num}.{$pos_num}.rot
      SETLIGHT 30
    GOTO @SPC_END_LOAD

    @SPC_ETROC
      COPY $pos_default &default.ETROC.{$chuck_num}.{$pos_num}.pos
      COPY $rot_default &default.ETROC.{$chuck_num}.{$pos_num}.rot
      SETLIGHT 8
    GOTO @SPC_END_LOAD

    @SPC_END_LOAD
    CALL @SURVEY_PART $pos_default $rot_default $part_id -> $pos $phi
    RETURN $pos $phi


@SURVEY_PART(pos_default,rot_default,part_id)
    # Arguments:
    #  $chuck_num - 
    #  $pos_num - 
    #   part_id=1 => Module PCB
    #   part_id=2 => ETROC
    # Returns
    #  $pos - center of part
    #  $phi - rotation of part in x-y plane

    GOTOIF @SP_MODULE_PCB `$part_id==1`
    GOTOIF @SP_ETROC `$part_id==2`
    
    @SP_MODULE_PCB
      COPY $tr_local &geometry.Module_PCB.fid_tr  
      COPY $tl_local &geometry.Module_PCB.fid_tl
      COPY $bl_local &geometry.Module_PCB.fid_bl
      COPY $br_local &geometry.Module_PCB.fid_br
    GOTO @SP_END_LOAD

    @SP_ETROC
      COPY $tr_local &geometry.ETROC.fid_tr  
      COPY $tl_local &geometry.ETROC.fid_tl
      COPY $bl_local &geometry.ETROC.fid_bl
      COPY $br_local &geometry.ETROC.fid_br
    GOTO @SP_END_LOAD

    @SP_END_LOAD
    #converts the local coordinates to global gantry coordinates usint start location and orientation
    TRANSFORML2G $tr_global $tr_local $pos_default $rot_default
    TRANSFORML2G $tl_global $tl_local $pos_default $rot_default
    TRANSFORML2G $bl_global $bl_local $pos_default $rot_default
    TRANSFORML2G $br_global $br_local $pos_default $rot_default

    #this is to get corrected centers and orientation, the code above gives general area
    CALL @ACQUIREFIDUCIAL $tr_global $part_id 1 -> $tr_corrected
    CALL @ACQUIREFIDUCIAL $br_global $part_id 2 -> $br_corrected
    CALL @ACQUIREFIDUCIAL $tl_global $part_id 4 -> $tl_corrected
    CALL @ACQUIREFIDUCIAL $bl_global $part_id 3 -> $bl_corrected

    # Turns measured corners or fiducials into center and orientation
    GOTOIF @FIT_MODULE_PCB `$part_id==1`
    GOTOIF @FIT_ETROC `$part_id==2`

    @FIT_MODULE_PCB
      FIT $pos $rot $res Module_PCB $tr_corrected $br_corrected $bl_corrected $tl_corrected
      PRINT "Located Module PCB at %v with rotation %q, %r degrees, fit residual=%f mm" $pos $rot $rot $res
      GOTO @FINISH_SURVEY
    @FIT_ETROC
      FIT $pos $rot $res ETROC $tr_corrected $br_corrected $bl_corrected $tl_corrected
      PRINT "Located TP ETROC at %v with rotation %q, %r degrees, fit residual=%f mm" $pos $rot $rot $res
      GOTO @FINISH_SURVEY

    @FINISH_SURVEY
    QUAT2EULER $phi $_ $_ $rot
    RETURN $pos $phi

@ACQUIREFIDUCIAL(start_pos,part_id,loc)
    # Arguments:
    #  $start_pos - Position to initially search for the fiducial
    #  $piece - PCB or ETROC, 1 or 2 respectively
    #  $loc - tr == 1, br == 2, bl == 3, tl == 4
    MOVETO $start_pos 75

    # GOTO @manual_fiducial_acquisition
    COPY &vision.autofocus.step_size 0.1
    AUTOFOCUS $_ 1 "" autoclose

    SETERRORMODE setvar
    WAIT 50
    FINDFID $fid_position ETROC
    GOTOIF @manual_fiducial_acquisition $ERR
    SETERRORMODE default
    RETURN $fid_position
    
    @manual_fiducial_acquisition
    SETERRORMODE default
    VIDEO
    getpos $fid_position
    PRINT "    Located fiducial %d at position %.3v" $loc $fid_position
    RETURN $fid_position